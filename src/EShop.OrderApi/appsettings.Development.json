{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Every SQL statement is logged at Information; the outbox publisher polls every 2 s and would flood the log.
      // Set it to Information again to see the SQL of a request.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // Keycloak runs on HTTP locally; production keeps the default (HTTPS required).
  "Authentication": { "RequireHttpsMetadata": false }
}
