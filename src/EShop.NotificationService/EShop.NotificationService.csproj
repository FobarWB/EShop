<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Consumes events from RabbitMQ and notifies the buyers by email. No HTTP endpoints. -->
  <PropertyGroup>
    <!-- Shared by all services: the RabbitMQ password and the database connection string. -->
    <UserSecretsId>eshop</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MailKit" />
    <!-- dotnet ef: NotificationDbContextFactory creates the context, the worker does not start. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EShop.Persistence\EShop.Persistence.csproj" />
    <ProjectReference Include="..\EShop.Messaging\EShop.Messaging.csproj" />
    <ProjectReference Include="..\EShop.OrderApi.Contracts\EShop.OrderApi.Contracts.csproj" />
  </ItemGroup>
</Project>
