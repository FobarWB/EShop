{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": ["http://localhost:4200"] },
  "Authentication": {
    "Authority": "http://localhost:8180/realms/eshop",
    "Audience": "eshop-api"
  },
  "KeycloakAdmin": {
    "CustomerApi": {
      "BaseUrl": "http://localhost:8180",
      "Realm": "eshop",
      "ClientId": "eshop-customerapi"
    }
  },
  "GuestAccounts": {
    "ClientId": "eshop-client",
    "RedirectUri": "http://localhost:8080/",
    "LinkLifespan": "1.00:00:00"
  }
}
