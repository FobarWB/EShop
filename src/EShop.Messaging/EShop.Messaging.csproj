<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared messaging infrastructure: the transactional outbox, the inbox of the consumers and RabbitMQ. -->
  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <!-- BackgroundService for the outbox publisher; the host itself comes from each service's SDK. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- The outbox and inbox entities live in each service's DbContext; Npgsql for PostgresException. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
</Project>
