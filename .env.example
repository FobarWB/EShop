# Copy to .env (git-ignored) and set your own values.

# Superuser "postgres": administration only.
POSTGRES_PASSWORD=change-me
# Application role "eshop": the same value goes into the user-secrets connection strings.
ESHOP_DB_PASSWORD=change-me
# Role "keycloak": the database of Keycloak.
KEYCLOAK_DB_PASSWORD=change-me
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Administrator of the Keycloak admin console (http://localhost:8180), master realm. Not a shop user.
KEYCLOAK_ADMIN_PASSWORD=change-me

# Images of the shop (compose profile "app"): unset = local builds (:local);
# latest or sha-<commit> = images published by CI (docker compose --profile app pull first).
# ESHOP_TAG=latest
