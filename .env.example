# Copy to .env (git-ignored) and set your own values.

# Superuser "postgres": administration only.
POSTGRES_PASSWORD=change-me
# One role and database per bounded context (#78); each value goes into the user-secrets connection string
# of that database (ConnectionStrings:Catalog, Cart, Ordering, Customer, Notification).
CATALOG_DB_PASSWORD=change-me
CART_DB_PASSWORD=change-me
ORDERING_DB_PASSWORD=change-me
CUSTOMER_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
# Role "eshop_test" (CREATEDB): integration tests pointed at this server through ConnectionStrings__EShopTests.
ESHOP_TEST_DB_PASSWORD=change-me
# Role "keycloak": the database of Keycloak.
KEYCLOAK_DB_PASSWORD=change-me
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Administrator of the Keycloak admin console (http://localhost:8180), master realm. Not a shop user.
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret of the Keycloak client eshop-orderapi (OrderApi reads users through the Admin API).
# The same value goes into the user-secrets: KeycloakAdmin:OrderApi:ClientSecret.
ORDERAPI_KEYCLOAK_SECRET=change-me
# Secret of the Keycloak client eshop-customerapi (CustomerApi creates the accounts of guest orders).
# The same value goes into the user-secrets: KeycloakAdmin:CustomerApi:ClientSecret.
CUSTOMERAPI_KEYCLOAK_SECRET=change-me

# User "eshop" of RabbitMQ (management UI http://localhost:15672 and the services), created on the first start.
RABBITMQ_PASSWORD=change-me

# Images of the shop (compose profile "app"): unset = local builds (:local);
# latest or sha-<commit> = images published by CI (docker compose --profile app pull first).
# ESHOP_TAG=latest
