{
  "realm": "eshop",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "actionTokenGeneratedByUserLifespan": 1800,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@eshop.local",
    "fromDisplayName": "EShop"
  },
  "roles": {
    "realm": [{ "name": "admin", "description": "Manages products and categories" }]
  },
  "clients": [
    {
      "clientId": "eshop-client",
      "name": "EShop Angular client",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "audience eshop-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "eshop-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "eshop-dev",
      "name": "Development only: tokens from the command line (password grant)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience eshop-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "eshop-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "eshop-orderapi",
      "name": "OrderApi: checks whether a guest's email already has an account",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${ORDERAPI_KEYCLOAK_SECRET}",
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "kc-admin-api"]
    },
    {
      "clientId": "eshop-customerapi",
      "name": "CustomerApi: creates the accounts of guest orders",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${CUSTOMERAPI_KEYCLOAK_SECRET}",
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "kc-admin-api"]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-00000000a001",
      "username": "admin",
      "enabled": true,
      "email": "admin@eshop.local",
      "emailVerified": true,
      "firstName": "Shop",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin1234", "temporary": false }],
      "realmRoles": ["default-roles-eshop", "admin"]
    },
    {
      "id": "00000000-0000-0000-0000-00000000c001",
      "username": "customer",
      "enabled": true,
      "email": "customer@eshop.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Customer",
      "credentials": [{ "type": "password", "value": "customer1234", "temporary": false }],
      "realmRoles": ["default-roles-eshop"]
    },
    {
      "username": "service-account-eshop-orderapi",
      "enabled": true,
      "serviceAccountClientId": "eshop-orderapi",
      "clientRoles": { "realm-management": ["view-users"] }
    },
    {
      "username": "service-account-eshop-customerapi",
      "enabled": true,
      "serviceAccountClientId": "eshop-customerapi",
      "clientRoles": { "realm-management": ["view-users", "manage-users"] }
    }
  ]
}
